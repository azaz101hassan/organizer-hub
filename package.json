{
  "name": "organizer-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Unified dashboard for event organizers",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "setup:env": "node scripts/setup-env.mjs",
    "setup:owner": "node scripts/promote-house-owner.mjs",
    "e2e": "pnpm -F @organizer-hub/e2e test",
    "e2e:member": "pnpm -F @organizer-hub/e2e test:member",
    "e2e:admin": "pnpm -F @organizer-hub/e2e test:admin"
  },
  "devDependencies": {
    "@organizer-hub/db": "workspace:*",
    "turbo": "^2.5.4",
    "typescript": "^5.7.3"
  }
}
