# =============================================
# Database connection strings
# =============================================
# Accounts service (OAuth2/OIDC IdP) — owns users, clients, tokens
ACCOUNTS_DATABASE_URL=postgresql://azazhassan@localhost:5432/accounts_db

# OrganizerHub API — owns orgs, events, tickets, memberships
API_DATABASE_URL=postgresql://azazhassan@localhost:5432/organizer_db

# =============================================
# Apps
# =============================================
WEB_PORT=3000
API_PORT=3001
ACCOUNTS_PORT=3002

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ACCOUNTS_URL=http://localhost:3002

# =============================================
# OIDC Identity Provider (apps/accounts)
# =============================================
ACCOUNTS_ISSUER_URL=http://localhost:3002
OIDC_COOKIE_KEYS=dev-cookie-secret-change-me
OIDC_KEYS_DIR=./.keys

# Audience claim stamped on access tokens — apps/api verifies this on every request.
# Must be an absolute URI (RFC 8707 resource indicator). Convention: the API's URL.
API_AUDIENCE=http://localhost:3001

# =============================================
# OAuth client for apps/web (consumed by web)
# =============================================
OAUTH_CLIENT_ID=organizer-web
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
# Where the IdP sends the browser back after RP-initiated logout. Must match the
# value seeded into oauth_clients.post_logout_redirect_uris.
OAUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/

# =============================================
# Stripe (test mode keys)
# =============================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
