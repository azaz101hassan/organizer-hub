# apps/api — per-app secrets. Copy to apps/api/.env.local and fill in real values.

# =============================================
# Stripe (test mode keys) — see docs/phase-3-stripe-setup.md
# =============================================
# Secret API key (sk_test_…) — back-end only, never ship to the browser.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Publishable key (pk_test_…) — safe in the browser.
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Webhook signing secret (whsec_…). For local dev, `stripe listen` prints a
# fresh one per session. In staging/prod, copy it from the Stripe Dashboard
# endpoint configuration.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# =============================================
# Transactional email (Resend) — see docs/phase-4-setup.md
# =============================================
# Resend API key (re_…). Leave empty in local dev: the Mailer logs a warning
# and skips delivery.
RESEND_API_KEY=re_REPLACE_ME
# From address on outbound mail. Use a domain verified in Resend in prod.
MAIL_FROM=OrganizerHub <onboarding@resend.dev>
# Absolute origin of the web app. Used to build dashboard deep-links inside
# approval/rejection emails.
WEB_ORIGIN=http://localhost:3000
# Comma-separated list of allowed CORS origins. Defaults to localhost:3000 and
# localhost:3003 when unset. Set this in production to restrict access.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
