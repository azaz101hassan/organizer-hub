<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create account · OrganizerHub</title>
  <style>
    :root { color-scheme: light dark; }
    * { box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #f5f5f7; }
    .card { background: #fff; padding: 2.5rem; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.08); width: 100%; max-width: 380px; }
    h1 { margin: 0 0 0.25rem; font-size: 1.5rem; }
    .sub { color: #666; margin: 0 0 1.5rem; font-size: 0.9rem; }
    label { display: block; margin: 0.75rem 0 0.25rem; font-size: 0.85rem; color: #444; }
    input { width: 100%; padding: 0.6rem 0.75rem; border: 1px solid #d2d2d7; border-radius: 8px; font-size: 0.95rem; }
    input:focus { outline: none; border-color: #0071e3; }
    button { width: 100%; margin-top: 1.25rem; padding: 0.7rem; background: #0071e3; color: #fff; border: none; border-radius: 8px; font-size: 0.95rem; cursor: pointer; font-weight: 500; }
    button:hover { background: #0077ed; }
    .footer { text-align: center; margin-top: 1.25rem; font-size: 0.85rem; color: #666; }
    .footer a { color: #0071e3; text-decoration: none; }
    .error { background: #ffe9e9; color: #b00020; padding: 0.6rem 0.75rem; border-radius: 6px; font-size: 0.85rem; margin-bottom: 0.5rem; }
    .hint { font-size: 0.75rem; color: #888; margin-top: 0.25rem; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Create account</h1>
    <p class="sub">Join OrganizerHub</p>

    <% if (error) { %><div class="error"><%= error %></div><% } %>

    <form method="post" action="/interaction/<%= uid %>/signup">
      <label for="name">Name</label>
      <input type="text" name="name" id="name" autofocus />

      <label for="email">Email</label>
      <input type="email" name="email" id="email" required />

      <label for="password">Password</label>
      <input type="password" name="password" id="password" minlength="8" required />
      <div class="hint">At least 8 characters.</div>

      <button type="submit">Create account</button>
    </form>

    <p class="footer">Already have an account? <a href="/interaction/<%= uid %>">Sign in</a></p>
  </div>
</body>
</html>
