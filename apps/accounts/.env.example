# apps/accounts — per-app secrets. Copy to apps/accounts/.env.local and fill in real values.

# =============================================
# OIDC Identity Provider
# =============================================
# Issuer URL stamped on tokens. Must match the IdP's public address.
ACCOUNTS_ISSUER_URL=http://localhost:3002

# Symmetric keys used to sign/encrypt OIDC session cookies (comma-separated,
# rotate by prepending a new secret and removing the oldest after a session TTL).
OIDC_COOKIE_KEYS=dev-cookie-secret-change-me

# Directory where the OIDC provider stores its asymmetric signing key files.
OIDC_KEYS_DIR=./.keys

# Audience claim stamped on access tokens — apps/api verifies this on every request.
# Must be an absolute URI (RFC 8707 resource indicator). Convention: the API's URL.
API_AUDIENCE=http://localhost:3001
