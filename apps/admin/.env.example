# apps/admin — per-app env. Run `pnpm setup:env` to copy this to .env.local.

# =============================================
# Public runtime config
# =============================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ACCOUNTS_URL=http://localhost:3002

# =============================================
# OAuth client overrides (optional)
# =============================================
# Defaults below match the in-code fallback (organizer-admin / port 3003).
# Uncomment and override only when running against a different OIDC client.
# OAUTH_CLIENT_ID=organizer-admin
# OAUTH_REDIRECT_URI=http://localhost:3003/auth/callback
# OAUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:3003/

# =============================================
# Server-side cookie wiring
# =============================================
# Name of the cookie set by the admin middleware that carries the access token.
# Must match cookiePrefix in src/middleware.ts. Read by apiFetch in
# packages/web-shared so admin and member sessions can co-exist in one browser.
OH_ACCESS_TOKEN_COOKIE=oh_admin_access_token

# =============================================
# Single-tenant binding
# =============================================
# The house Organization id printed by `pnpm -F api seed`. Admin reads this
# at runtime via getHouseOrgId() to scope every server action and API call.
HOUSE_ORG_ID=org_house_000000000000000001
