# apps/member — per-app env. Copy to apps/member/.env.local and adjust as needed.

# =============================================
# Public runtime config
# =============================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ACCOUNTS_URL=http://localhost:3002

# =============================================
# OAuth client overrides (optional)
# =============================================
# Defaults below match the in-code fallback (organizer-member). Uncomment and
# override only when running against a different OIDC client registration.
# OAUTH_CLIENT_ID=organizer-member
# OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
# OAUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
