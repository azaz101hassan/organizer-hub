// API bounded context — owns organizations, organization members, events.
// Consumed by apps/api. The `userId` columns reference User.id from
// accounts_db; deliberately no FK across the bounded-context boundary.

generator client {
  provider = "prisma-client-js"
  output   = "../client/api"
}

datasource db {
  provider = "postgresql"
  url      = env("API_DATABASE_URL")
}

// ---------- Enums ----------

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

// Three tiers, ordered by inclusivity: GOLD covers everything SILVER does,
// SILVER covers everything BRONZE does. `tierLevel` is the numeric form used
// for coverage comparisons (TicketType.min_tier_level vs Membership.tierLevel).
enum MembershipTier {
  BRONZE
  SILVER
  GOLD
}

// Mirrors the Stripe subscription status enum we care about. Stripe also emits
// `trialing` and `unpaid`/`incomplete*` states; we mirror them verbatim so a
// raw `syncStripeData` upsert never has to bucket statuses lossily.
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAUSED
}

// Why a ticket landed in the user's account. PAID flows through Stripe
// Checkout (payment mode) and a checkout.session.completed webhook; the
// MEMBERSHIP_CLAIM path (U8) skips Stripe entirely. Carrying provenance on
// the row lets refund / revocation flows in Phase 4+ route correctly.
enum TicketSource {
  PAID
  MEMBERSHIP_CLAIM
}

// Phase 4 waitlist. A TicketRequest is created in place of an instant issue
// when a TicketType is at cap. Intent mirrors TicketSource: PAID requests get
// an emailed Checkout link on approval; MEMBERSHIP_CLAIM requests issue a
// Ticket inline on approval.
enum TicketRequestIntent {
  PAID
  MEMBERSHIP_CLAIM
}

// Five-state lifecycle. PENDING is the only mutable state for admin/requester
// actions; the four terminal/awaiting states are reached via compare-and-set
// transitions. APPROVED is "awaiting payment" for PAID until a Ticket links to
// the request; it is "issued" immediately for MEMBERSHIP_CLAIM.
enum TicketRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED_BY_USER
  EXPIRED
}

// The admin verb captured on each moderation decision (R14). Intentionally
// not generalized for scheduler/cancel sources — only admin approve/reject is
// audited.
enum TicketRequestDecision {
  APPROVE
  REJECT
}

// ---------- Organizations ----------

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdBy   String   @map("created_by") // sub from accounts; no FK across contexts
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members     OrganizationMember[]
  events      Event[]
  eventLabels EventLabel[]

  @@map("organizations")
}

// ---------- Organization members ----------

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id") // sub from accounts
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

// ---------- Events ----------

model Event {
  id              String      @id @default(cuid())
  organizationId  String      @map("organization_id")
  title           String
  slug            String // unique within org
  description     String?
  startsAt        DateTime    @map("starts_at")
  endsAt          DateTime?   @map("ends_at")
  venue           String?
  status          EventStatus @default(DRAFT)
  publishedAt     DateTime?   @map("published_at")
  membersExcluded Boolean     @default(false) @map("members_excluded")
  labelId         String?     @map("label_id")
  createdBy       String      @map("created_by") // sub from accounts
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          EventLabel?     @relation(fields: [labelId], references: [id], onDelete: SetNull)
  ticketTypes    TicketType[]
  tickets        Ticket[]
  ticketRequests TicketRequest[]

  @@unique([organizationId, slug])
  @@index([status, startsAt])
  @@index([organizationId, startsAt])
  @@index([labelId])
  @@map("events")
}

// ---------- Event labels ----------

// Per-org categorization tag (e.g., "Concerts", "Workshops"). Events optionally
// reference one EventLabel via Event.labelId; the FK uses SET NULL so deleting
// a label clears its references without cascading event deletes. The admin app
// (Phase E) is the only writer.
model EventLabel {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       Event[]

  @@unique([organizationId, slug])
  @@index([organizationId, sortOrder])
  @@map("event_labels")
}

// ---------- Tickets ----------

// Per-event ticket tier (GA / VIP / etc.). Each TicketType is mirrored to a
// dedicated Stripe Product + Price; Prices are immutable in Stripe, so a
// priceCents change here archives the old Price and creates a new one.
// stripeProductId / stripePriceId never leak via the public endpoint —
// callers see only the local id, name, priceCents, and minTierLevel.
model TicketType {
  id              String   @id @default(cuid())
  eventId         String   @map("event_id")
  name            String
  priceCents      Int      @map("price_cents")
  minTierLevel    Int      @default(0) @map("min_tier_level")
  // Optional soft cap on issued tickets. null = no cap (Phase 3 instant-issue
  // behavior). When set, U5 routes at-cap purchases/claims into the waitlist.
  // A DB CHECK (cap IS NULL OR cap >= 1) backs the DTO @Min(1) — Prisma 6.x
  // cannot express CHECK constraints, so it lives in the migration.
  cap             Int?
  stripeProductId String   @unique @map("stripe_product_id")
  stripePriceId   String   @unique @map("stripe_price_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets        Ticket[]
  ticketRequests TicketRequest[]

  @@index([eventId])
  @@map("ticket_types")
}

// Issued ticket for one attendee. Source carries provenance (PAID vs
// MEMBERSHIP_CLAIM). Idempotency is scoped to source:
//   - PAID: stripeCheckoutSessionId @unique catches redelivered
//     checkout.session.completed events.
//   - MEMBERSHIP_CLAIM (U8): service-layer pre-flight enforces one claim
//     per (userId, eventId, ticketTypeId, source=MEMBERSHIP_CLAIM).
// We intentionally do NOT unique (userId, eventId, ticketTypeId) at the
// schema layer — a family-of-four buying four GA tickets from one account
// is legitimate.
model Ticket {
  id                      String       @id @default(cuid())
  userId                  String       @map("user_id")
  eventId                 String       @map("event_id")
  ticketTypeId            String       @map("ticket_type_id")
  source                  TicketSource
  stripeCheckoutSessionId String?      @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?      @unique @map("stripe_payment_intent_id")
  // Back-link to the waitlist request this Ticket fulfilled, if any (null for
  // instant under-cap issues). @unique is the DB-level "at most one Ticket per
  // request" guarantee (R25) — the first real issuance-uniqueness constraint
  // on a request→ticket path. ON DELETE SET NULL: a purged TicketRequest must
  // never cascade-delete an issued, paid Ticket — the Ticket is the durable
  // artifact, the request is only provenance.
  ticketRequestId         String?      @unique @map("ticket_request_id")
  issuedAt                DateTime     @default(now()) @map("issued_at")

  ticketType    TicketType     @relation(fields: [ticketTypeId], references: [id])
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketRequest TicketRequest? @relation(fields: [ticketRequestId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventId])
  @@index([ticketTypeId])
  @@index([userId, eventId, ticketTypeId, source])
  @@map("tickets")
}

// ---------- Ticket requests (Phase 4 waitlist) ----------

// A pending-or-resolved request for a ticket on an at-cap TicketType. eventId
// is denormalized (copied at creation) so the org-scoped admin queue and SSE
// org resolution never need a TicketType→Event join on every read.
//
// One-open-request-per-(user, tier) is enforced by a hand-written PARTIAL
// UNIQUE INDEX (user_id, ticket_type_id) WHERE status IN ('PENDING','APPROVED')
// that Prisma 6.x cannot express — it lives in the migration
// add_ticket_request_partial_unique and is guarded against drift on boot.
model TicketRequest {
  id                      String              @id @default(cuid())
  userId                  String              @map("user_id") // sub from accounts; no FK across contexts
  // Requester contact, snapshotted from the JWT at intake. The API bounded
  // context has no User table, so the admin/scheduler email flows (R16) cannot
  // look the requester up later — the address must travel with the request.
  userEmail               String?             @map("user_email")
  userName                String?             @map("user_name")
  ticketTypeId            String              @map("ticket_type_id")
  eventId                 String              @map("event_id")
  intent                  TicketRequestIntent
  status                  TicketRequestStatus @default(PENDING)
  // Set at PAID approval (U7). The server-written back-link the webhook
  // resolves the request by — authoritative over attacker-influenceable
  // session metadata. @unique so a redelivered session can't double-link.
  stripeCheckoutSessionId String?             @unique @map("stripe_checkout_session_id")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticket     Ticket?

  @@index([eventId, status])
  @@index([userId])
  @@map("ticket_requests")
}

// One row per admin moderation decision (R14). Captures who decided, the cap
// at decision time, and the issued count before/after so an over-cap approval
// is permanently recorded. Not generalized for scheduler/cancel sources — and
// deliberately not FK-linked to TicketRequest, so the audit trail survives any
// future purge of the request it describes.
model TicketRequestAudit {
  id                String                @id @default(cuid())
  ticketRequestId   String                @map("ticket_request_id")
  adminUserId       String                @map("admin_user_id") // sub from accounts
  decision          TicketRequestDecision
  capAtDecision     Int?                  @map("cap_at_decision")
  issuedCountBefore Int                   @map("issued_count_before")
  issuedCountAfter  Int                   @map("issued_count_after")
  createdAt         DateTime              @default(now()) @map("created_at")

  @@index([ticketRequestId])
  @@map("ticket_request_audits")
}

// Durable record of an auto-refund issued when a Checkout completed against a
// no-longer-payable waitlist request (cancelled/rejected in the approval->pay
// window, or the event already started). stripeCheckoutSessionId is @unique so
// the dead-request branch can UPSERT it — a redelivered event yields exactly
// one record matching the one actual (idempotency-keyed) refund. Intentionally
// not FK-linked, so the money-movement record outlives any request purge.
model RefundLog {
  id                      String   @id @default(cuid())
  ticketRequestId         String?  @map("ticket_request_id")
  stripeCheckoutSessionId String   @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?  @map("stripe_payment_intent_id")
  reason                  String
  amountCents             Int      @map("amount_cents")
  createdAt               DateTime @default(now()) @map("created_at")

  @@map("refund_logs")
}

// ---------- Billing ----------

// Maps an OrganizerHub user (OIDC `sub`) to a Stripe Customer. Lazy-created on
// first checkout: getOrCreateStripeCustomer(userSub) upserts here. The Stripe
// Customer is the source of truth; this row is only the lookup.
model BillingCustomer {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  stripeCustomerId String   @unique @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("billing_customers")
}

// Idempotency / dedupe gate for incoming Stripe webhook events. Inserted at
// the end of the handler transaction; P2002 on a redelivered event causes the
// handler to swallow the duplicate and ack 200. Payload is not stored — Stripe
// remains the source of truth for replay.
model WebhookEvent {
  stripeEventId String   @id @map("stripe_event_id")
  type          String
  receivedAt    DateTime @default(now()) @map("received_at")

  @@index([type])
  @@map("webhook_events")
}

// ---------- Memberships ----------

// Catalog row for one of the six membership SKUs (tier × cadence). The
// `lookupKey` matches the `lookup_key` configured on the corresponding
// Stripe Price — `syncStripeData` reads that key from the subscription item
// to derive the local tier and tierLevel. Stripe owns price + amount; this
// row owns the local mapping and display copy.
model MembershipPlan {
  id          String         @id @default(cuid())
  lookupKey   String         @unique @map("lookup_key")
  tier        MembershipTier
  tierLevel   Int            @map("tier_level")
  displayName String         @map("display_name")
  cadence     String // 'monthly' | 'yearly' — string, not enum, to mirror Stripe's `recurring.interval` shape

  @@unique([tier, cadence])
  @@map("membership_plans")
}

// Local mirror of a Stripe subscription, keyed by `userId` (one active
// subscription per user is enforced via @unique). `syncStripeData(customerId)`
// upserts this row from a Stripe Subscription read; Stripe remains the source
// of truth, this row is the read cache so coverage checks and dashboard
// renders don't touch the network.
model Membership {
  id                   String             @id @default(cuid())
  userId               String             @unique @map("user_id")
  stripeCustomerId     String             @map("stripe_customer_id")
  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  status               SubscriptionStatus
  tier                 MembershipTier
  tierLevel            Int                @map("tier_level")
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@index([stripeCustomerId])
  @@map("memberships")
}

enum PaymentEventKind {
  TICKET
  MEMBERSHIP
  DONATION
  REFUND
  DISPUTE
}

enum PaymentEventStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

// Local mirror of Stripe money-movement. One row per PaymentIntent (kind in
// {TICKET, MEMBERSHIP, DONATION}); separate negative-amount rows per Refund /
// Dispute object. amountCents is signed: refunds/disputes negative. Net per
// PaymentIntent = SUM(amount_cents) of all rows sharing stripe_payment_intent_id.
//
// stripePaymentIntentId is NOT @unique because refund rows reference the same
// PI as the charge they refund. The (stripePaymentIntentId, kind) composite
// unique gates the single charge row per PI; refund rows are gated by the
// @unique stripeRefundId.
model PaymentEvent {
  id                       String              @id @default(cuid())
  organizationId           String              @map("organization_id")
  userId                   String              @map("user_id")
  kind                     PaymentEventKind
  status                   PaymentEventStatus
  amountCents              Int                 @map("amount_cents")
  currency                 String
  description              String?

  stripeCustomerId         String?             @map("stripe_customer_id")
  stripePaymentIntentId    String?             @map("stripe_payment_intent_id")
  stripeCheckoutSessionId  String?             @map("stripe_checkout_session_id")
  stripeInvoiceId          String?             @map("stripe_invoice_id")
  stripeRefundId           String?             @unique @map("stripe_refund_id")
  stripeChargeId           String?             @map("stripe_charge_id")

  ticketId                 String?             @map("ticket_id")
  ticketRequestId          String?             @map("ticket_request_id")
  membershipId             String?             @map("membership_id")
  refundsPaymentIntentId   String?             @map("refunds_payment_intent_id")

  failureReason            String?             @map("failure_reason")
  succeededAt              DateTime?           @map("succeeded_at")
  canceledAt               DateTime?           @map("canceled_at")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt       @map("updated_at")

  @@unique([stripePaymentIntentId, kind], map: "payment_events_pi_kind_key")
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([stripePaymentIntentId])
  @@index([stripeCheckoutSessionId])
  @@map("payment_events")
}
