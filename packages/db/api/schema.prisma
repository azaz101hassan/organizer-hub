// API bounded context — owns organizations, organization members, events.
// Consumed by apps/api. The `userId` columns reference User.id from
// accounts_db; deliberately no FK across the bounded-context boundary.

generator client {
  provider = "prisma-client-js"
  output   = "../client/api"
}

datasource db {
  provider = "postgresql"
  url      = env("API_DATABASE_URL")
}

// ---------- Enums ----------

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

// Three tiers, ordered by inclusivity: GOLD covers everything SILVER does,
// SILVER covers everything BRONZE does. `tierLevel` is the numeric form used
// for coverage comparisons (TicketType.min_tier_level vs Membership.tierLevel).
enum MembershipTier {
  BRONZE
  SILVER
  GOLD
}

// Mirrors the Stripe subscription status enum we care about. Stripe also emits
// `trialing` and `unpaid`/`incomplete*` states; we mirror them verbatim so a
// raw `syncStripeData` upsert never has to bucket statuses lossily.
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAUSED
}

// ---------- Organizations ----------

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdBy   String   @map("created_by") // sub from accounts; no FK across contexts
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members OrganizationMember[]
  events  Event[]

  @@map("organizations")
}

// ---------- Organization members ----------

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id") // sub from accounts
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

// ---------- Events ----------

model Event {
  id              String      @id @default(cuid())
  organizationId  String      @map("organization_id")
  title           String
  slug            String // unique within org
  description     String?
  startsAt        DateTime    @map("starts_at")
  endsAt          DateTime?   @map("ends_at")
  venue           String?
  status          EventStatus @default(DRAFT)
  publishedAt     DateTime?   @map("published_at")
  membersExcluded Boolean     @default(false) @map("members_excluded")
  createdBy       String      @map("created_by") // sub from accounts
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketTypes  TicketType[]

  @@unique([organizationId, slug])
  @@index([status, startsAt])
  @@index([organizationId, startsAt])
  @@map("events")
}

// ---------- Tickets ----------

// Per-event ticket tier (GA / VIP / etc.). Each TicketType is mirrored to a
// dedicated Stripe Product + Price; Prices are immutable in Stripe, so a
// priceCents change here archives the old Price and creates a new one.
// stripeProductId / stripePriceId never leak via the public endpoint —
// callers see only the local id, name, priceCents, and minTierLevel.
model TicketType {
  id              String   @id @default(cuid())
  eventId         String   @map("event_id")
  name            String
  priceCents      Int      @map("price_cents")
  minTierLevel    Int      @default(0) @map("min_tier_level")
  stripeProductId String   @unique @map("stripe_product_id")
  stripePriceId   String   @unique @map("stripe_price_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("ticket_types")
}

// ---------- Billing ----------

// Maps an OrganizerHub user (OIDC `sub`) to a Stripe Customer. Lazy-created on
// first checkout: getOrCreateStripeCustomer(userSub) upserts here. The Stripe
// Customer is the source of truth; this row is only the lookup.
model BillingCustomer {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  stripeCustomerId String   @unique @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("billing_customers")
}

// Idempotency / dedupe gate for incoming Stripe webhook events. Inserted at
// the end of the handler transaction; P2002 on a redelivered event causes the
// handler to swallow the duplicate and ack 200. Payload is not stored — Stripe
// remains the source of truth for replay.
model WebhookEvent {
  stripeEventId String   @id @map("stripe_event_id")
  type          String
  receivedAt    DateTime @default(now()) @map("received_at")

  @@index([type])
  @@map("webhook_events")
}

// ---------- Memberships ----------

// Catalog row for one of the six membership SKUs (tier × cadence). The
// `lookupKey` matches the `lookup_key` configured on the corresponding
// Stripe Price — `syncStripeData` reads that key from the subscription item
// to derive the local tier and tierLevel. Stripe owns price + amount; this
// row owns the local mapping and display copy.
model MembershipPlan {
  id          String         @id @default(cuid())
  lookupKey   String         @unique @map("lookup_key")
  tier        MembershipTier
  tierLevel   Int            @map("tier_level")
  displayName String         @map("display_name")
  cadence     String // 'monthly' | 'yearly' — string, not enum, to mirror Stripe's `recurring.interval` shape

  @@unique([tier, cadence])
  @@map("membership_plans")
}

// Local mirror of a Stripe subscription, keyed by `userId` (one active
// subscription per user is enforced via @unique). `syncStripeData(customerId)`
// upserts this row from a Stripe Subscription read; Stripe remains the source
// of truth, this row is the read cache so coverage checks and dashboard
// renders don't touch the network.
model Membership {
  id                   String             @id @default(cuid())
  userId               String             @unique @map("user_id")
  stripeCustomerId     String             @map("stripe_customer_id")
  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  status               SubscriptionStatus
  tier                 MembershipTier
  tierLevel            Int                @map("tier_level")
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@index([stripeCustomerId])
  @@map("memberships")
}
