// API bounded context — owns organizations, organization members, events.
// Consumed by apps/api. The `userId` columns reference User.id from
// accounts_db; deliberately no FK across the bounded-context boundary.

generator client {
  provider = "prisma-client-js"
  output   = "../client/api"
}

datasource db {
  provider = "postgresql"
  url      = env("API_DATABASE_URL")
}

// ---------- Enums ----------

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

// ---------- Organizations ----------

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdBy   String   @map("created_by") // sub from accounts; no FK across contexts
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members OrganizationMember[]
  events  Event[]

  @@map("organizations")
}

// ---------- Organization members ----------

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id") // sub from accounts
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

// ---------- Events ----------

model Event {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  title          String
  slug           String      // unique within org
  description    String?
  startsAt       DateTime    @map("starts_at")
  endsAt         DateTime?   @map("ends_at")
  venue          String?
  status         EventStatus @default(DRAFT)
  publishedAt    DateTime?   @map("published_at")
  createdBy      String      @map("created_by") // sub from accounts
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([status, startsAt])
  @@index([organizationId, startsAt])
  @@map("events")
}

// ---------- Billing ----------

// Maps an OrganizerHub user (OIDC `sub`) to a Stripe Customer. Lazy-created on
// first checkout: getOrCreateStripeCustomer(userSub) upserts here. The Stripe
// Customer is the source of truth; this row is only the lookup.
model BillingCustomer {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  stripeCustomerId String   @unique @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("billing_customers")
}

// Idempotency / dedupe gate for incoming Stripe webhook events. Inserted at
// the end of the handler transaction; P2002 on a redelivered event causes the
// handler to swallow the duplicate and ack 200. Payload is not stored — Stripe
// remains the source of truth for replay.
model WebhookEvent {
  stripeEventId String   @id @map("stripe_event_id")
  type          String
  receivedAt    DateTime @default(now()) @map("received_at")

  @@index([type])
  @@map("webhook_events")
}
